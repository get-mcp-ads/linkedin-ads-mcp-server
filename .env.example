# linkedin-ads-mcp-server configuration
# Use your own LinkedIn app, approved for the Advertising API. See the README.

# Member access token with r_ads and r_ads_reporting (and rw_ads for writes).
LINKEDIN_ADS_ACCESS_TOKEN=

# Alternative to the token above, for apps approved for programmatic refresh
# tokens: the server renews the access token in memory. All three go together.
# LINKEDIN_ADS_REFRESH_TOKEN=
# LINKEDIN_ADS_CLIENT_ID=
# LINKEDIN_ADS_CLIENT_SECRET=

# Required. Comma-separated numeric ad account IDs from Campaign Manager.
# Every other account is refused before any request, reads included.
LINKEDIN_ADS_ACCOUNT_IDS=

# Optional. The scopes actually granted to the token. When set, write tools
# refuse to run without rw_ads. Setting it grants nothing.
# LINKEDIN_ADS_SCOPES=r_ads r_ads_reporting

# Write tools are off by default. Only the exact value true exposes them.
# Every write still previews first and applies only with confirm: true.
LINKEDIN_ADS_ENABLE_WRITES=false

# Optional. LinkedIn-Version header, YYYYMM.
# LINKEDIN_ADS_API_VERSION=202608

# Optional. debug | info | warn | error. Logs go to stderr.
# LINKEDIN_ADS_LOG_LEVEL=info
